{
  "java.project.sourcePaths": ["src"],
  "java.project.outputPath": "bin",
  "java.project.referencedLibraries": ["lib/**/*.jar"],
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.formatOnType": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit",
    "source.fixAll": "explicit"
  },
  "editor.minimap": {
    "enabled": true
  },
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.cursorBlinking": "smooth",
  "editor.fontSize": 14,
  "editor.fontFamily": "JetBrains Mono, Fira Code, Consolas, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.wordWrap": "on",
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.renderWhitespace": "boundary",
  "editor.suggestSelection": "first",
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "on",
    "strings": "on"
  },
  "editor.suggestOnTriggerCharacters": true,
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  "editor.suggest.showKeywords": true,
  "editor.suggest.showSnippets": true,
  "editor.suggest.showMethods": true,
  "editor.suggest.showFields": true,
  "editor.suggest.showClasses": true,
  "editor.suggest.showInterfaces": true,
  "editor.suggest.preview": true,
  "editor.suggest.localityBonus": true,
  "editor.suggest.shareSuggestSelections": true,
  "editor.suggest.filterGraceful": true,
  "editor.acceptSuggestionOnCommitCharacter": true,
  "editor.acceptSuggestionOnEnter": "on",
  "editor.inlineSuggest.enabled": true,
  "editor.inlineSuggest.suppressSuggestions": false,
  "editor.snippetSuggestions": "inline",
  "editor.wordBasedSuggestions": "matchingDocuments",
  "editor.selectionHighlight": true,
  "editor.occurrencesHighlight": "singleFile",
  "editor.hover.enabled": "on",
  "editor.hover.delay": 300,
  "editor.parameterHints.enabled": true,
  "editor.parameterHints.cycle": true,
  "editor.autoClosingBrackets": "always",
  "editor.autoClosingQuotes": "always",
  "editor.autoClosingComments": "always",
  "editor.linkedEditing": true,
  "editor.stickyScroll.enabled": true,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "files.exclude": {
    "bin/": true,
    "**/.classpath": true,
    "**/.project": true,
    "**/.settings": true,
    "**/.factorypath": true
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.java": "${capture}.class",
    ".vscode": ".gitignore"
  },
  "workbench.colorTheme": "One Dark Pro Night Flat",
  "workbench.startupEditor": "none",
  "workbench.tree.indent": 16,
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.scrollback": 5000,
  "code-runner.executorMap": {
    "java": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$workspaceRoot/.vscode/run.ps1\" $fullFileName"
  },
  "code-runner.runInTerminal": true,
  "code-runner.saveFileBeforeRun": true,
  "code-runner.clearPreviousOutput": false,
  "code-runner.ignoreSelection": true,
  "code-runner.showExecutionMessage": true,
  "java.debug.settings.console": "integratedTerminal",
  "java.debug.settings.forceBuildBeforeLaunch": true,
  "java.debug.settings.hotCodeReplace": "auto",
  "java.debug.settings.showStaticVariables": true,
  "java.terminal.autoActivate": true,
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.errors.incompleteClasspath.severity": "warning",
  "java.saveActions.organizeImports": true,
  "java.completion.importOrder": ["java", "javax", "com", "org"],
  "java.codeGeneration.hashCodeEquals.useJava7Objects": true,
  "java.inlayHints.parameterNames.enabled": "all",
  "github.copilot.enable": {
    "*": true,
    "plaintext": true,
    "markdown": true,
    "yaml": true,
    "html": true
  },
  "github.copilot.editor.enableAutoCompletions": true,
  "github.copilot.inlineSuggest.enable": true,
  "github.copilot.advanced": {
    "showOptionsInCompletionList": true
  }
}
